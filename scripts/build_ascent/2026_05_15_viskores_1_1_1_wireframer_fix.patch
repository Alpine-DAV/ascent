+bool IsTwoDimensionalCellShape(viskores::UInt8 cellShape)
+{
+  switch (cellShape)
+  {
+    case viskores::CELL_SHAPE_TRIANGLE:
+    case viskores::CELL_SHAPE_POLYGON:
+    case viskores::CELL_SHAPE_QUAD:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsTwoDimensionalCellSet(const viskores::cont::UnknownCellSet& cellSet)
+{
+  if (cellSet.CanConvert<viskores::cont::CellSetStructured<2>>())
+  {
+    return true;
+  }
+
+  const viskores::Id numCells = cellSet.GetNumberOfCells();
+  if (numCells < 1)
+  {
+    return false;
+  }
+
+  for (viskores::Id cellIndex = 0; cellIndex < numCells; ++cellIndex)
+  {
+    if (!IsTwoDimensionalCellShape(cellSet.GetCellShape(cellIndex)))
+    {
+      return false;
+    }
+  }
+
+  return true;
+}
