###############################################################################
# file: vtkh_config.mk
###############################################################################
#
# A CMake-generated Make include file Defines the following Make variables:
#
######
#  VTKH_INCLUDE_FLAGS
#  VTKH_LIB_FLAGS
#  VTKH_MPI_LIB_FLAGS
######
#
# For use in another Makefile build system
############################################################################

VTKH_DIR = @ASCENT_INSTALL_PREFIX@

VTKH_VISKORES_DIR = @ASCENT_VISKORES_DIR@
VTKH_VISKORES_VERSION = @ASCENT_VISKORES_VERSION@

VTKH_OPENMP_LINK_FLAGS = @OpenMP_CXX_FLAGS@

VTKH_MPI_LIBS =@ASCENT_CONFIG_MK_MPI_LINK_FLAGS@

#########################
# VISKORES
#########################

#########################
# include settings from installed viskores
#########################
include $(VTKH_VISKORES_DIR)/share/viskores-$(VTKH_VISKORES_VERSION)/viskores_config.mk

#########################
# viskores lib flags
#########################
VTKH_VISKORES_LIB_FLAGS = $(Viskores_LIB_FLAGS)

#########################
# viskores include flags
#########################
VTKH_VISKORES_INCLUDE_FLAGS = $(Viskores_INCLUDE_FLAGS)

#########################
# VTKH
#########################

#########################
# VTKH Include Flags
#########################
VTKH_INCLUDE_FLAGS = -I $(VTKH_DIR)/include/ascent/ $(VISKORES_VISKORES_INCLUDE_FLAGS)

#########################
# VTKH Lib Flags
#########################

# If using VTKH without mpi
VTKH_LIB_FLAGS=-L $(VTKH_DIR)/lib \
                  -lvtkh_rendering \
                  -lvtkh_compositing \
                  -lvtkh_filters \
                  -lvtkh_core \
                  -lvtkh_utils \
                  -lascent_lodepng $(VTKH_VISKORES_LIB_FLAGS) $(VTKH_OPENMP_LINK_FLAGS)


# If using VTKH with mpi
VTKH_MPI_LIB_FLAGS=-L $(VTKH_DIR)/lib \
                      -lvtkh_rendering_mpi \
                      -lvtkh_compositing_mpi \
                      -lvtkh_filters_mpi \
                      -lvtkh_core_mpi \
                      -lvtkh_utils_mpi \
                      -lascent_lodepng $(VTKH_VISKORES_LIB_FLAGS) $(VTKH_OPENMP_LINK_FLAGS)



